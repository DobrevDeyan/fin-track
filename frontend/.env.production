# Production build-time environment.
# Next.js inlines NEXT_PUBLIC_* into the static bundle at `next build`, so every
# value the app needs in prod MUST be here (a clean CI checkout has no .env.local).
#
# Everything below is PUBLIC by design: Firebase web config, the Stripe
# *publishable* key, the FCM *public* VAPID key, and the Sentry DSN are all shipped
# to the browser. NEVER put secrets here (sk_* / rk_*, GEMINI_API_KEY,
# service-account JSON) — this file is committed to git.

# Firebase (same project as dev)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyAj_TioYX7kZsDm9uuKPVrf8BwuOmaN1hA
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fin-track-adc2c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fin-track-adc2c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=fin-track-adc2c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=185936461123
NEXT_PUBLIC_FIREBASE_APP_ID=1:185936461123:web:90b48701c1a520457383f6
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-YRYCTR1THT

# ML service (Cloud Run)
NEXT_PUBLIC_ML_SERVICE_URL=https://ml-service-185936461123.europe-west1.run.app

