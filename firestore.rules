rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Validates goal monetary fields on the resulting document (review G6).
    // Applied on create/update for both personal goals and householdGoals so a
    // client cannot persist negative/garbage targets or amounts.
    function validGoalData(d) {
      return d.name is string && d.name.size() > 0
        && d.targetAmount is number && d.targetAmount > 0
        && d.currentAmount is number && d.currentAmount >= 0;
    }

    // Validates recurring-transaction fields on the resulting document (review
    // R5-4). Applied on create/update so a client cannot persist garbage that
    // the scheduler would later turn into real ledger entries. amount cap
    // mirrors AMOUNT_RULES.MAX (1,000,000) in the frontend.
    function validRecurringData(d) {
      return d.name is string && d.name.size() > 0
        && d.amount is number && d.amount > 0 && d.amount <= 1000000
        && d.type in ['income', 'expense']
        && d.frequency in ['weekly', 'monthly', 'yearly']
        && d.category is string && d.category.size() > 0
        && d.nextDate is timestamp
        && d.isActive is bool;
    }

    // Validates savings-account fields on the resulting document (review S-14).
    // Applied on create/update so a client cannot persist a negative, oversized,
    // or non-numeric balance — savings balances feed net worth and the dashboard
    // total, so a forged value would corrupt those aggregates. balance cap mirrors
    // AMOUNT_RULES.MAX (1,000,000) in the frontend.
    function validSavingsData(d) {
      return d.name is string && d.name.size() > 0
        && d.balance is number && d.balance >= 0 && d.balance <= 1000000
        && d.currency is string && d.currency.size() > 0
        && d.isActive is bool;
    }

    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // In-app notification inbox — written by Cloud Functions (Admin SDK), read/update by owner
      match /notifications/{notifId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        // Allow client to mark notifications as read (update only)
        allow update: if request.auth != null && request.auth.uid == userId;
        // Only Admin SDK (Cloud Functions) may create or delete
        allow create, delete: if false;
      }
    }

    // Entries - users can only access their own entries
    match /entries/{entryId} {
      // Allow get (single document read) if user owns it
      allow get: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow list only when query is constrained to the authenticated user's own documents
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow create if user is authenticated and sets their own userId
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Allow update if user owns the entry AND the ownerId is not being changed
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;
      // Allow delete if user owns the entry
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Categories - users can only access their own categories
    match /categories/{categoryId} {
      allow get, list: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Budgets - users can only access their own budgets
    match /budgets/{budgetId} {
      // Allow get (single document read) if user owns it
      allow get: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow list only when query is constrained to the authenticated user's own documents
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow create if user is authenticated and sets their own userId
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      // Allow update if user owns the budget AND the ownerId is not being changed
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;
      // Allow delete if user owns the budget
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Savings Accounts - users can only access their own savings accounts
    match /savingsAccounts/{accountId} {
      // Allow get (single document read) if user owns it
      allow get: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow list only when query is constrained to the authenticated user's own documents
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow create if user is authenticated, sets their own userId, and the data is valid
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
                    && validSavingsData(request.resource.data);
      // Allow update if user owns the account, the ownerId is not changing, and the data is valid
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && validSavingsData(request.resource.data);
      // Allow delete if user owns the account
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Goals - users can only access their own goals
    match /goals/{goalId} {
      // Allow get (single document read) if user owns it
      allow get: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow list only when query is constrained to the authenticated user's own documents
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow create if user is authenticated, sets their own userId, and the data is valid
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
                    && validGoalData(request.resource.data);
      // Allow update if user owns the goal, the ownerId is not changing, and the data is valid
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && validGoalData(request.resource.data);
      // Allow delete if user owns the goal
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Financial Summaries - document ID is the userId.
    // SERVER-AUTHORITATIVE: maintained only by the maintainFinancialSummary
    // Cloud Function (Admin SDK). Clients may read their own summary and delete
    // it (e.g. account reset/deletion), but may NOT create or update it — this
    // prevents forged totals that would corrupt the dashboard or game the
    // leaderboard (review LB1).
    match /financialSummaries/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if false;
    }

    // Recurring Transactions - users can only access their own recurring transactions
    match /recurringTransactions/{transactionId} {
      // Allow get (single document read) if user owns it
      allow get: if request.auth != null && request.auth.uid == resource.data.userId;
      // Allow list only when query is constrained to the authenticated user's own documents
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      // Allow create if user is authenticated, sets their own userId, and the
      // document passes field validation
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId
                    && validRecurringData(request.resource.data);
      // Allow update if user owns the transaction, the ownerId is not being
      // changed, and the resulting document is still valid
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId
                    && validRecurringData(request.resource.data);
      // Allow delete if user owns the transaction
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // AI Insights cache - document ID is userId
    match /aiInsights/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Scan usage quota - document ID is userId, written only by Admin SDK
    match /scanUsage/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Debt Payoff Planner — one document per user, owner-only access
    match /userDebts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ===== Stripe Extension Collections =====

    // Products and prices — synced from Stripe, read-only for authenticated users
    match /products/{productId} {
      allow read: if request.auth != null;

      match /prices/{priceId} {
        allow read: if request.auth != null;
      }

      match /tax_rates/{taxRateId} {
        allow read: if request.auth != null;
      }
    }

    // Customer data — each user can only access their own
    match /customers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Checkout sessions — users can create and read their own
      match /checkout_sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Subscriptions — read-only for the user; written by extension service account
      match /subscriptions/{subscriptionId} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }

      // Payments — read-only for the user; written by extension service account
      match /payments/{paymentId} {
        allow read: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Assets (net worth tracking)
    match /assets/{assetId} {
      allow get: if request.auth != null && request.auth.uid == resource.data.userId;
      allow list: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // ===== Household / Family Budgeting =====

    // Helper: check if the current user is a member of a given household
    function isHouseholdMember(householdId) {
      return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids;
    }

    // Shared household budgets — any member can read/write; householdId is immutable on update
    match /householdBudgets/{budgetId} {
      allow read: if isHouseholdMember(resource.data.householdId);
      allow create: if isHouseholdMember(request.resource.data.householdId);
      allow update: if isHouseholdMember(resource.data.householdId)
                    && request.resource.data.householdId == resource.data.householdId;
      allow delete: if isHouseholdMember(resource.data.householdId);
    }

    // Shared household goals — any member can read/write; householdId is immutable on update
    match /householdGoals/{goalId} {
      allow read: if isHouseholdMember(resource.data.householdId);
      allow create: if isHouseholdMember(request.resource.data.householdId)
                    && validGoalData(request.resource.data);
      allow update: if isHouseholdMember(resource.data.householdId)
                    && request.resource.data.householdId == resource.data.householdId
                    && validGoalData(request.resource.data);
      allow delete: if isHouseholdMember(resource.data.householdId);
    }

    // Household document — members can read/list; only Admin SDK writes.
    // memberUids is a flat string[] kept in sync with the members array by Cloud Functions.
    match /households/{householdId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.memberUids;
      allow write: if false;
    }

    // Invite documents — invitee (by email) and sender can read; only Admin SDK writes
    match /householdInvites/{inviteId} {
      allow read: if request.auth != null
                  && (request.auth.uid == resource.data.invitedBy
                      || request.auth.token.email == resource.data.invitedEmail);
      allow write: if false;
    }

    // Audit log — written only by Admin SDK (Cloud Functions), never by clients
    match /auditLog/{logId} {
      allow read, write: if false;
    }

    // Rate limits — written only by Admin SDK (Cloud Functions), never by clients
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }

    // ===== Leaderboard =====

    // Per-user profile: owner can read their own score; only Admin SDK writes
    match /leaderboardProfiles/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Aggregate stats: any authenticated user can read; only Admin SDK writes
    match /leaderboardStats/{statId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
