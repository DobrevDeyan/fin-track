# OCR backend for receipt scanning: 'document-ai' (default) or 'gemini-vision'
OCR_BACKEND=document-ai

# Google Cloud Platform Configuration (Document AI backend)
GCP_PROJECT_ID=fin-track-adc2c
GCP_PROCESSOR_ID=566b35e21d475435
GCP_LOCATION=eu

# Gemini vision backend (used when OCR_BACKEND=gemini-vision). Reuses GEMINI_API_KEY.
# See docs/GEMINI_VISION_EVALUATION.md — for real EU user images, route via Vertex AI.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-3.5-flash-lite

# Path to service account key file
GOOGLE_APPLICATION_CREDENTIALS=./keys/fin-track-adc2c-cc35184300f1.json

# Server Configuration
PORT=8000

# CORS Configuration
FRONTEND_URL=http://localhost:3001
